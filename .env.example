# =============================================================================
# NORA VOICE AGENT - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# For Railway: Add these as environment variables in your Railway dashboard
# =============================================================================

# -----------------------------------------------------------------------------
# LIVEKIT CONFIGURATION (Required)
# Get these from: https://cloud.livekit.io
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# -----------------------------------------------------------------------------
# SPEECH-TO-TEXT: DEEPGRAM (Required)
# Get your API key from: https://console.deepgram.com
# Free tier: $200 credit
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key

# -----------------------------------------------------------------------------
# TEXT-TO-SPEECH: CARTESIA (Required)
# Get your API key from: https://play.cartesia.ai
# -----------------------------------------------------------------------------
CARTESIA_API_KEY=your_cartesia_api_key

# Optional: Custom voice ID (default is a standard Cartesia voice)
# CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# -----------------------------------------------------------------------------
# LLM: OPENAI (Required for intelligent responses)
# Get your API key from: https://platform.openai.com
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key

# Optional: Override model (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Health check port (Railway uses this)
HEALTH_CHECK_PORT=8081

# Agent worker name (for identification in LiveKit dashboard)
# LIVEKIT_AGENT_NAME=nora-voice-agent
