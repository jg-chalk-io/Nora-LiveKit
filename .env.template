# LiveKit Configuration
# WebSocket URL to your LiveKit server instance (wss:// for secure, ws:// for insecure)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud

# LiveKit API key for authentication (obtain from LiveKit dashboard)
LIVEKIT_API_KEY=your-api-key

# LiveKit API secret for token generation (obtain from LiveKit dashboard)
LIVEKIT_API_SECRET=your-api-secret

# FastAPI Health Check Configuration
# Port for health check endpoint (required by Railway deployment)
HEALTH_CHECK_PORT=8080

# Logging Configuration
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output format (json for structured logs, text for human-readable)
LOG_FORMAT=json

# Optional: Test Room Configuration
# Room name for development/testing (leave empty for production)
# LIVEKIT_TEST_ROOM=test-room-001

# Optional: Deployment Environment
# Environment identifier (development, staging, production)
# RAILWAY_ENVIRONMENT=production

# VOICE PIPELINE CONFIGURATION (SPEC-LIVEKIT-002)
# Speech-to-Text (Deepgram) Configuration
DEEPGRAM_API_KEY=b15ebb488ee6d779f3c48de3b757a18d555a375b
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US

# Text-to-Speech (Cartesia) Configuration
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=default-sonic-voice
CARTESIA_SPEED=1.0
CARTESIA_EMOTION=neutral

# Voice Pipeline Configuration
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_LATENCY_TARGET=500
VAD_THRESHOLD=0.5
