# =============================================================================
# NORA LIVEKIT VOICE AGENT - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys

# LiveKit Configuration
# WebSocket URL to your LiveKit server instance
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# =============================================================================
# VOICE PIPELINE (Required)
# =============================================================================

# Speech-to-Text & Text-to-Speech - Deepgram
# Get key at: https://console.deepgram.com/
# Used for BOTH STT (Nova-3) and TTS (Aura-2)
DEEPGRAM_API_KEY=your-deepgram-api-key

# TTS Voice - Deepgram Aura-2 voices
# Browse voices: https://developers.deepgram.com/docs/tts-models
# Options: aura-2-helena-en (warm female), aura-2-thalia-en, aura-2-andromeda-en
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# =============================================================================
# LLM CONFIGURATION (Required - at least one provider)
# =============================================================================

# LLM Provider Selection: openai, groq, cerebras, ultravox
# Default: openai
# Note: ultravox is speech-to-speech (no separate STT/TTS needed)
LLM_PROVIDER=openai

# OpenAI (default provider)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Groq (alternative - ultra-fast inference)
# Get key at: https://console.groq.com/
# Models: llama-3.1-8b-instant, llama-3.3-70b-versatile, mixtral-8x7b-32768
# GROQ_API_KEY=your-groq-api-key

# Cerebras (alternative - fast inference)
# Get key at: https://cloud.cerebras.ai/
# Models: llama-3.1-8b, llama-3.3-70b
# CEREBRAS_API_KEY=your-cerebras-api-key

# Ultravox (speech-to-speech - lowest latency)
# Get key at: https://api.ultravox.ai/settings
# This is a REALTIME model - handles STT+LLM+TTS in single connection
# When using Ultravox, DEEPGRAM_API_KEY is not needed for STT/TTS
ULTRAVOX_API_KEY=key
ULTRAVOX_VOICE=Jessica 

# Model name (depends on provider)
# OpenAI: gpt-4o-mini (fast), gpt-4o (smarter)
# Groq: llama-3.1-8b-instant (fastest), llama-3.3-70b-versatile
# Cerebras: llama-3.1-8b, llama-3.3-70b
LLM_MODEL=gpt-4o-mini

# Max tokens for LLM response (lower = faster, less verbose)
# Recommended: 100-200 for voice (short, natural responses)
LLM_MAX_TOKENS=150

# =============================================================================
# OFFICE CONFIGURATION (Customize for your clinic)
# =============================================================================
OFFICE_NAME=Humber Veterinary Clinic
OFFICE_HOURS=Monday-Friday 8 AM-6 PM, Saturday 9 AM-2 PM
OFFICE_ADDRESS=123 Humber Valley Blvd, Toronto, ON
OFFICE_WEBSITE=https://humberveterinary.com
OFFICE_PHONE=4165550198
# Set to "true" during business hours
IS_CLINIC_OPEN=false

# =============================================================================
# OBSERVABILITY (Optional)
# =============================================================================

# Langfuse - Voice Agent Tracing
# Get keys at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# Use https://hipaa.cloud.langfuse.com for HIPAA compliance
LANGFUSE_HOST=https://cloud.langfuse.com
# Enable/disable tracing (default: true)
LANGFUSE_ENABLED=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
